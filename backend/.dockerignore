# =============================================================================
# Auto-Wish AI — Backend .dockerignore
# Keeps the Docker build context lean and avoids leaking secrets into images.
# =============================================================================

# ── Secrets — never bake into images ─────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python bytecode & cache ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── SQLite (use PostgreSQL in Docker) ────────────────────────────────────────
*.sqlite3

# ── Static / Media (generated at runtime) ────────────────────────────────────
staticfiles/
media/

# ── Tests & Coverage ─────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
*.log

# ── Celery beat schedule ──────────────────────────────────────────────────────
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
