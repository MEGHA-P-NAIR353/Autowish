# =============================================================================
# Auto-Wish AI — Backend Environment Variables Example
# Copy to backend/.env for local (non-Docker) development.
# For Docker development, use the root .env instead.
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-50-random-chars-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Security (set True only in HTTPS production) ──────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# ── Database (local non-Docker dev — uses localhost) ─────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=autowish_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis (local non-Docker dev) ──────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── AI Providers (Priority: 1. Gemini → 2. Groq → 3. OpenRouter) ─────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_RETRY_MAX_OUTPUT_TOKENS=3072
GEMINI_MAX_TRUNCATION_RETRIES=1

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,groq/compound-mini,openai/gpt-oss-20b,qwen/qwen3.6-27b

OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,minimax/minimax-m3:free,google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

AI_CACHE_TTL=86400
AI_PROVIDER_TIMEOUT=15.0

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=AutoWish AI <your-gmail@gmail.com>

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_AI=True
ENABLE_EMAIL=True
ENABLE_SMS=False
ENABLE_WHATSAPP=False

# ── Misc ──────────────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
DEFAULT_PAGE_SIZE=20
MAX_UPLOAD_SIZE=10485760
