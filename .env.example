# =============================================================================
# Auto-Wish AI — Root Environment File (Docker Compose)
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env   (Windows)
#                       cp .env.example .env      (Linux/macOS)
#   2. Fill in the secrets marked with  <-- CHANGE THIS
#   3. Run:  docker compose up --build
#
# This file is read by docker-compose.yml.
# It is injected into all containers as environment variables.
# NEVER commit the real .env to version control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# DJANGO
# ─────────────────────────────────────────────────────────────────────────────
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-with-a-50-char-random-string   # <-- CHANGE THIS

DEBUG=True

# Comma-separated hostnames Django will accept requests for.
# Keep localhost and 127.0.0.1 for local Docker dev.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origins the browser is allowed to access the backend from.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trusted origins for CSRF (must include the frontend URL).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY (leave False for local dev)
# ─────────────────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# ─────────────────────────────────────────────────────────────────────────────
# POSTGRESQL  (Docker service name = "postgres")
# DB_HOST must be "postgres" — that is the Docker Compose service name.
# DO NOT use localhost here.
# ─────────────────────────────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=autowish_db
DB_USER=autowish_user
DB_PASSWORD=change_me_strong_password   # <-- CHANGE THIS
DB_HOST=postgres
DB_PORT=5432

# These three variables configure the PostgreSQL container itself.
# They MUST match DB_NAME / DB_USER / DB_PASSWORD above.
POSTGRES_DB=autowish_db
POSTGRES_USER=autowish_user
POSTGRES_PASSWORD=change_me_strong_password   # <-- CHANGE THIS (same as DB_PASSWORD)

# ─────────────────────────────────────────────────────────────────────────────
# REDIS  (Docker service name = "redis")
# DO NOT use localhost or 127.0.0.1 here.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# ── AI Providers (Priority: 1. Gemini → 2. Groq → 3. OpenRouter) ─────────────
GEMINI_API_KEY=your-gemini-api-key-here              # <-- CHANGE THIS
GEMINI_MODEL=gemini-3.6-flash
# gemini-3.6-flash is a thinking model: needs 2048+ tokens to cover thinking overhead
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_RETRY_MAX_OUTPUT_TOKENS=3072
GEMINI_MAX_TRUNCATION_RETRIES=1

GROQ_API_KEY=your-groq-api-key-here                  # <-- CHANGE THIS
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,gemma2-9b-it

OPENROUTER_API_KEY=your-openrouter-api-key-here      # <-- CHANGE THIS
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,mistralai/mistral-7b-instruct:free,qwen/qwen-2.5-72b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

AI_CACHE_TTL=86400
AI_PROVIDER_TIMEOUT=15.0

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL  (Gmail SMTP)
# For Gmail: enable 2FA then create an App Password at:
#   https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com                  # <-- CHANGE THIS
EMAIL_HOST_PASSWORD=your-16-char-app-password         # <-- CHANGE THIS
DEFAULT_FROM_EMAIL=AutoWish AI <your-gmail@gmail.com> # <-- CHANGE THIS

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────────────────────────
# URL shown in outgoing emails (password reset links, etc.)
FRONTEND_URL=http://localhost:5173

# Vite dev server proxy target — must point to the backend Docker service.
# DO NOT use localhost:8000 here; use the Docker service name.
VITE_API_PROXY_TARGET=http://backend:8000

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_AI=True
ENABLE_EMAIL=True
ENABLE_SMS=False
ENABLE_WHATSAPP=False

# ─────────────────────────────────────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
DEFAULT_PAGE_SIZE=20
MAX_UPLOAD_SIZE=10485760

# ─────────────────────────────────────────────────────────────────────────────
# ENTRYPOINT CONTROL (advanced — usually leave as-is)
# Set to "false" for celery_worker / celery_beat so they don't re-run migrations.
# docker-compose.yml sets these per-service.
# ─────────────────────────────────────────────────────────────────────────────
# RUN_MIGRATIONS=true
# RUN_COLLECTSTATIC=true
